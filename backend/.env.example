# ---- 应用 ----
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai
MAX_QUERY_DAYS=366
PREVIEW_ROWS=20

# ---- 数据源适配器：rpa | api ----
DATA_SOURCE=rpa

# 第一阶段：RPA 模拟下载 Excel 的落盘目录
RPA_DOWNLOAD_DIR=.runtime/rpa_downloads
# 模拟浏览器操作耗时（秒），生产替换为真实 RPA 后删除
RPA_SIMULATE_DELAY_SECONDS=0.2

# 第二阶段：真实 API 数据源（APIFetcher 当前为可替换的占位实现）
PROPERTY_API_BASE_URL=
PROPERTY_API_KEY=

# ---- DeepSeek ----
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30
# 未配置 Key 或模型调用失败时，是否降级到本地中文时间规则解析
LLM_FALLBACK_ENABLED=true
