# ---- 应用 ----
APP_ENV=development
LOG_LEVEL=INFO
TIMEZONE=Asia/Shanghai
MAX_QUERY_DAYS=366
PREVIEW_ROWS=20

# ---- 数据源适配器：rpa | api ----
DATA_SOURCE=rpa

# 第一阶段：RPA 模拟下载 Excel 的落盘目录
RPA_DOWNLOAD_DIR=.runtime/rpa_downloads
# 模拟浏览器操作耗时（秒），生产替换为真实 RPA 后删除
RPA_SIMULATE_DELAY_SECONDS=0.2

# 第二阶段：真实 API 数据源（APIFetcher 当前为可替换的占位实现）
PROPERTY_API_BASE_URL=
PROPERTY_API_KEY=

# ---- 大模型 Provider（BYOK） ----
# 请求体传入 provider_type / user_api_key / model_name 时优先使用用户配置；
# 未传时使用下面的系统兜底配置。
DEFAULT_LLM_PROVIDER=deepseek
LLM_FALLBACK_ENABLED=true

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_TIMEOUT_SECONDS=30

# 豆包 / 火山方舟（OpenAI 兼容端点）
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=doubao-seed-1-6-250615

# 通义千问 / DashScope（OpenAI 兼容模式）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus

# ---- 多表目录与 Excel 导入 ----
# 目录中若有 .xlsx，代码查询优先使用多表数据；为空时回退 RPA 单表。
TABLE_DIRECTORY_ENABLED=true
DATA_TABLE_DIR=.runtime/rpa_downloads/tables
TABLE_MAX_FILES=50
TABLE_MAX_ROWS=50000
TABLE_MAX_COLUMNS=100
TABLE_UPLOAD_MAX_BYTES=20000000
TABLE_UPLOAD_MAX_FILES=10
TABLE_UPLOAD_MAX_UNCOMPRESSED_BYTES=200000000
# 前端 8081 直传 FastAPI 时的跨域白名单，逗号分隔
CORS_ORIGINS=http://127.0.0.1:8081,http://localhost:8081

# ---- 生成式 Pandas 查询 ----
# 新增端点：POST /api/v1/assistant/query/code
CODE_QUERY_ENABLED=true
# bwrap 为强制隔离模式；disabled 时端点会拒绝执行，不会退化为主进程 exec
CODE_SANDBOX_MODE=bwrap
CODE_MAX_RETRIES=2
CODE_LLM_TIMEOUT_SECONDS=20
CODE_EXEC_TIMEOUT_SECONDS=8
CODE_TOTAL_TIMEOUT_SECONDS=50
CODE_MAX_RESULT_ROWS=5000
CODE_MAX_RESULT_COLUMNS=50
CODE_MAX_CELL_CHARS=1000
CODE_SAMPLE_ROWS=5
CODE_EXPOSE_GENERATED_CODE=true

# ---- 查询结果 Excel 导出与下载 ----
# 文件只落在 Python 本地，由 Java 网关校验文件名后流式代理给前端。
REPORT_EXPORT_ENABLED=true
REPORT_EXPORT_DIR=.runtime/exports
REPORT_EXPORT_TTL_SECONDS=3600
REPORT_EXPORT_MAX_FILES=100
REPORT_EXPORT_MAX_BYTES=20000000
